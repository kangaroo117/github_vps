{
  "name": "Arm Socrates Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "forwardPorts":,
  "portsAttributes": {
    "6080": {
      "label": "Web Desktop",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "vncserver :1 -geometry 1920x1080 -depth 24 -SecurityTypes None && nohup /opt/novnc/utils/novnc_proxy --vnc localhost:5901 --listen 6080 > /tmp/novnc.log 2>&1 &"
}
